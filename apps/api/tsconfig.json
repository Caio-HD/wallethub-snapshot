{
  "extends": "@wallethub/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2019",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "paths": {
      "@app/*": ["src/*"],
      "@config/*": ["src/core/config/*"],
      "@common/*": ["src/common/*"],
      "@modules/*": ["src/modules/*"],
      "@queues/*": ["src/queues/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tests/**/*.ts", "data-source.ts", "jest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
