{
  "name": "@wallethub/api",
  "version": "1.2.0",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist',{recursive:true});\"",
    "prebuild": "npm run clean",
    "build": "nest build && npm run build:data-source",
    "build:data-source": "tsc data-source.ts --outDir dist --module commonjs --target es2019 --esModuleInterop --skipLibCheck --resolveJsonModule --declaration false",
    "validate-build": "npm run lint && npm run build",
    "migration:run": "node scripts/run-migrations.js",
    "deps:check": "node scripts/check-runtime-deps.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "test": "jest",
    "test:audit-guard": "jest tests/unit/platform-audit-coverage.spec.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:vitest": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "WalletHub API",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@google-cloud/vertexai": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@notionhq/client": "^2.2.15",
    "@simplewebauthn/server": "^13.3.2",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.63.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "date-fns": "^4.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.2",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-i18n": "^10.8.4",
    "nestjs-pino": "^4.4.1",
    "openai": "^4.78.1",
    "otplib": "^13.4.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pino": "^9.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.0",
    "twilio": "^5.13.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.1",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.18",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.10.0",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.46.3",
    "@wallethub/config": "*",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  }
}
