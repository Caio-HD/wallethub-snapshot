# WalletHub – Ambiente de Produção (API + Web)
# Copie para .env.production e preencha valores sensíveis. Não commitar .env.production.
#
# Este arquivo é a fonte única de verdade da configuração de produção.
# A CLI gera a partir dele:
# - ops/prod/.env.deploy (usado pelo docker-compose de produção)
# - config/envs/production.json (manifesto para CLI / DB)

# --- App ---
NODE_ENV=production
PORT=3000
API_PREFIX=api
# URL pública do frontend em produção
FRONTEND_URL=https://www.exemplo.com

# --- Database (Produção) ---
# Opção 1: URL única
DATABASE_URL=postgres://wallethub:change_me@localhost:55432/wallethub
# Opção 2: variáveis separadas
DB_HOST=localhost
DB_PORT=55432
DB_USER=wallethub
DB_PASSWORD=change_me
DB_NAME=wallethub
DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
# TYPEORM_LOGGING=false

# --- Redis (Produção) ---
REDIS_URL=redis://localhost:56379
REDIS_HOST=localhost
REDIS_PORT=56379
# REDIS_PASSWORD=
# REDIS_TLS=false

# --- JWT (usar chaves RSA geradas pela CLI) ---
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=86400s

# --- WhatsApp via Evolution API (wallethub.example.com) ---
EVOLUTION_API_URL=https://wallethub.example.com
EVOLUTION_API_KEY=alterar
EVOLUTION_INSTANCE_NAME=wallethub
# Configurar em Evolution: instância → webhook → URL = https://wallethub.example.com/whatsapp/webhook

# --- Storage (anexos) ---
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/var/storage/wallethub
# S3: STORAGE_S3_BUCKET= STORAGE_S3_REGION= STORAGE_S3_ENDPOINT= STORAGE_S3_ACCESS_KEY_ID= STORAGE_S3_SECRET_ACCESS_KEY=
# MinIO: STORAGE_MINIO_BUCKET= STORAGE_MINIO_ENDPOINT= STORAGE_MINIO_ACCESS_KEY= STORAGE_MINIO_SECRET_KEY=
# STORAGE_MAX_FILE_SIZE=
# STORAGE_ALLOWED_MIME_TYPES=

# --- Notion (sync opcional) ---
# NOTION_API_KEY=
# NOTION_TRANSACTIONS_DB_ID=
# NOTION_ACCOUNTS_DB_ID=
# NOTION_CATEGORIES_DB_ID=
# NOTION_PROJECTIONS_DB_ID=
# NOTION_WEBHOOK_SECRET=
# NOTION_SYNC_ENABLED=false
# NOTION_RETRY_MAX_ATTEMPTS=
# NOTION_RETRY_DELAY_MS=

# --- Notificações / OTP (Resend e Twilio) ---
# RESEND_API_KEY=re_...
# RESEND_FROM=WalletHub <noreply@example.dev>   # o dominio PRECISA estar verificado no Resend
# EMAIL_OTP_SUBJECT=Seu código de verificação WalletHub
# EMAIL_OTP_HTML=<p>Código: <strong>{{otp}}</strong> (expira em {{ttlMinutes}} min).</p>
# EMAIL_OTP_TTL_MINUTES=5
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_OTP_BODY=Seu código WalletHub é: {{otp}}
#
# OTP por WhatsApp (Evolution) — em produção a env é só *capability*
# (EVOLUTION_API_KEY + instância). O liga/desliga é runtime, via console admin
# (tabela platform_settings, chave otp_whatsapp). EVOLUTION_OTP_DEV_ENABLED é
# ignorado em produção.
# EVOLUTION_OTP_INSTANCE_NAME=wallethub   # default; sobreposto pelo settings do console

# --- IA ---
# Provider ativo: openrouter | openai | vertex | deepseek | none (rollback por ENV).
AI_DEFAULT_PROVIDER=openrouter

# OpenRouter — modelos free (compatível OpenAI). Injete a chave real como SECRET no paas.
# Capacidades (tools) validadas em jun/2026; revalidar via GET /health/llm antes de trocar.
OPENROUTER_API_KEY=sk-or-v1-...
# Lista de rotação (1º = primário). chatWithTools exige tool-calling. Fallback em 429/5xx/timeout.
OPENROUTER_MODELS=moonshotai/kimi-k2.6:free,openai/gpt-oss-120b:free,qwen/qwen3-next-80b-a3b-instruct:free,z-ai/glm-4.5-air:free
OPENROUTER_TIMEOUT_MS=30000

# OpenAI — INATIVO como chat, mas a chave é usada pelos EMBEDDINGS do RAG (OpenRouter não faz embeddings).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Vertex: VERTEX_PROJECT_ID= VERTEX_LOCATION=us-central1 VERTEX_MODEL=gemini-1.5-flash
# GOOGLE_APPLICATION_CREDENTIALS=/path/para/service-account.json
# Deepseek: DEEPSEEK_API_KEY= DEEPSEEK_MODEL=deepseek-chat
AI_REQUEST_TIMEOUT_MS=20000

# --- Traefik / Domínios ---
TRAEFIK_ACME_EMAIL=seu-email@exemplo.com
TRAEFIK_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
WALLETHUB_PRIMARY_DOMAIN=www.exemplo.com
WALLETHUB_SECONDARY_DOMAIN=exemplo.com
WALLETHUB_API_USE_DIRECT=false

# --- Frontend (Vite) ---
VITE_API_URL=https://www.exemplo.com/api
VITE_WHATSAPP_STATUS_POLL=60000

